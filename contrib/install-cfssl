#!/usr/bin/env bash
# Install cfssl and cfssljson into /usr/local/bin after verifying them against
# the release checksums. The unit tests need them outside of the Nix
# environment. Usage: install-cfssl [<version>]
set -euo pipefail

# cfssl version
CFSSL_VERSION=1.7.1

VERSION="${1:-$CFSSL_VERSION}"
ARCH=$(uname -m)
case "$ARCH" in
  x86_64)  ARCH="amd64" ;;
  aarch64) ARCH="arm64" ;;
  *)       echo "Unsupported architecture: $ARCH" >&2; exit 1 ;;
esac
BASE_URL="https://github.com/cloudflare/cfssl/releases/download/v${VERSION}"

TMP_DIR=$(mktemp -d)
trap 'rm -rf "$TMP_DIR"' EXIT

CHECKSUMS="cfssl_${VERSION}_checksums.txt"
curl -fsSLo "$TMP_DIR/$CHECKSUMS" "${BASE_URL}/${CHECKSUMS}"

for BIN in cfssl cfssljson; do
  FILE="${BIN}_${VERSION}_linux_${ARCH}"
  curl -fsSLo "$TMP_DIR/$FILE" "${BASE_URL}/${FILE}"
  # Fails as well if the checksums file has no entry for the binary
  (cd "$TMP_DIR" && awk -v f="$FILE" '$2 == f' "$CHECKSUMS" | sha256sum -c --strict -)
  install -m 0755 "$TMP_DIR/$FILE" "/usr/local/bin/$BIN"
done
